#!name=po0 防火墙自动加白
#!desc=自动加白当前出口；网络切换/引擎启动执行稳定窗口复验，iOS 每 10 分钟唤醒兜底，并提供手动面板。
#!category=po0
#!author=reallinzc, prur
#!arguments=tokens:""
#!arguments-desc=tokens: po0 防火墙 API token（pgnfw_ 开头），多台机器用英文逗号 , 分割；可选在 token 后加 @槽位（如 pgnfw_xxx@0）钉固定坑位、永不被淘汰

[Rule]
# 加白 API 必须直连，确保 API 看到的是本机真实出口 IP 而不是代理出口
IP-CIDR,124.221.69.228/32,DIRECT,no-resolve

[Script]
po0-fw-cron = type=cron,cronexp="*/10 * * * *",wake-system=true,script-path=https://raw.githubusercontent.com/prur/po0fw/ae29f759f64c21b71ed9ea2bc0b326a7da7388ba/scripts/po0-firewall-whitelist.js,timeout=60,argument="tokens={{{tokens}}}"
po0-fw-event = type=event,event-name=network-changed,script-path=https://raw.githubusercontent.com/prur/po0fw/ae29f759f64c21b71ed9ea2bc0b326a7da7388ba/scripts/po0-firewall-whitelist.js,timeout=60,argument="tokens={{{tokens}}}"
po0-fw-start = type=event,event-name=engine-started,script-path=https://raw.githubusercontent.com/prur/po0fw/ae29f759f64c21b71ed9ea2bc0b326a7da7388ba/scripts/po0-firewall-whitelist.js,timeout=60,argument="tokens={{{tokens}}}"
po0-fw-panel = type=generic,script-path=https://raw.githubusercontent.com/prur/po0fw/ae29f759f64c21b71ed9ea2bc0b326a7da7388ba/scripts/po0-firewall-whitelist.js,timeout=60,argument="tokens={{{tokens}}}"

[Panel]
po0-fw = script-name=po0-fw-panel,title=po0 防火墙加白,content=点击刷新,update-interval=1
